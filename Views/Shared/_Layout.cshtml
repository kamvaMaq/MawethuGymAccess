<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mawethu Gym Access</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body {
            background-color: #0E0F11;
            color: #FFFFFF;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }
        .sidebar {
            width: 260px;
            background-color: #121417;
            border-right: 1px solid #1E2124;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            padding: 20px;
        }
        .main-content {
            margin-left: 260px;
            padding: 30px;
            background-color: #0E0F11;
            min-height: 100vh;
        }
        .nav-link-custom {
            color: #8C929B;
            padding: 10px 15px;
            border-radius: 8px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 5px;
            font-weight: 500;
        }
        .nav-link-custom:hover, .nav-link-custom.active {
            background-color: #1E2124;
            color: #D4E84A;
        }
        .card-custom {
            background-color: #16181C;
            border: 1px solid #1E2124;
            border-radius: 12px;
            padding: 24px;
        }
        .btn-lemon {
            background-color: #D4E84A;
            color: #0E0F11;
            font-weight: bold;
            border-radius: 8px;
        }
        .btn-lemon:hover {
            background-color: #bece3c;
            color: #0E0F11;
        }
    </style>
</head>
<body>
    <!-- Sidebar Navigation -->
    <div class="sidebar d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-2 mb-4 px-2">
                <div class="bg-warning text-dark fw-bold rounded px-2 py-1 fs-5">M</div>
                <div>
                    <h6 class="mb-0 fw-bold text-white">MAWETHU <span style="color: #D4E84A;">GYM</span></h6>
                    <small class="text-success" style="font-size: 11px;">● Front desk online</small>
                </div>
            </div>

            <div class="nav flex-column">
                <a class="nav-link-custom active" asp-controller="Member" asp-action="AdminDashboard">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>
                <a class="nav-link-custom" asp-controller="Member" asp-action="CheckIn">
                    <i class="bi bi-camera"></i> Face scanner
                </a>
                <a class="nav-link-custom" asp-controller="Member" asp-action="Register">
                    <i class="bi bi-person-plus"></i> Add member
                </a>
                <a class="nav-link-custom" asp-controller="Member" asp-action="AdminDashboard">
                    <i class="bi bi-journal-text"></i> Gym register
                </a>
                <a class="nav-link-custom" asp-controller="Member" asp-action="ExportCheckIns">
                    <i class="bi bi-download"></i> Download register
                </a>
            </div>
        </div>

        <div class="border-top border-secondary pt-3">
            <small class="text-muted d-block">Operator</small>
            <span class="text-white fw-bold">@Context.Session.GetString("StaffName") ?? "Staff"</span>
            <a asp-action="StaffLogout" class="text-danger small d-block mt-1 text-decoration-none">Log out</a>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@{
    ViewData["Title"] = "Staff Workspace - Settings";
}

<div class="mb-4">
    <small class="text-muted text-uppercase">Staff Workspace</small>
    <h2 class="fw-bold text-white">Settings</h2>
</div>

<div class="card-custom mb-4">
    <h4 class="fw-bold text-white mb-3">Camera & privacy</h4>
    <div class="mb-3">
        <label class="form-label text-muted">Face data retention policy</label>
        <div class="p-3 rounded bg-dark border border-secondary text-white">
            Delete 30 days after membership ends (POPIA Compliant)
        </div>
    </div>
    <div class="form-check form-switch mt-3">
        <input class="form-check-input" type="checkbox" id="emailDailyRegister" checked>
        <label class="form-check-label text-white" for="emailDailyRegister">Email me the daily register at 21:00</label>
    </div>
</div>

@model IEnumerable<MawethuGym.Web.Models.Member>

@{
    ViewData["Title"] = "Staff Workspace - Members";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <small class="text-muted text-uppercase">Staff Workspace</small>
        <h2 class="fw-bold text-white">Your community</h2>
    </div>
    <a asp-action="Register" class="btn btn-lemon px-4 py-2">+ Add member</a>
</div>

<!-- Search Bar -->
<div class="card-custom mb-4 py-3">
    <form method="get" asp-action="Members">
        <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
            <input type="text" name="search" class="form-control bg-dark text-white border-secondary" placeholder="Search name, phone or member number..." />
        </div>
    </form>
</div>

<!-- Member Cards Grid -->
<div class="row g-4">
    @foreach (var member in Model)
    {
        var isExpired = member.ExpiryDate < DateTime.UtcNow;
        <div class="col-md-4">
            <div class="card-custom">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        @string.Concat(member.FullName.Split(' ').Select(n => n[0]))
                    </div>
                    <div>
                        <h6 class="fw-bold text-white mb-0">@member.FullName</h6>
                        <small class="text-warning">@member.MemberNumber &bull; @member.Phone</small>
                    </div>
                </div>

                <div class="mb-3">
                    @if (isExpired)
                    {
                        <span class="badge bg-danger text-white"><i class="bi bi-exclamation-triangle"></i> Overdue</span>
                    }
                    else
                    {
                        <span class="badge bg-success text-dark"><i class="bi bi-check-circle"></i> Active</span>
                    }
                </div>

                <div class="d-flex justify-content-between text-muted small border-top border-secondary pt-3">
                    <span>Valid until: @member.ExpiryDate.ToString("yyyy-MM-dd")</span>
                    <a href="#" class="text-warning text-decoration-none">View profile &gt;</a>
                </div>
            </div>
        </div>
    }
</div>

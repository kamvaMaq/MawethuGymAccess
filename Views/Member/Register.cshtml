@model MawethuGym.Web.ViewModels.MemberRegisterViewModel

@{
    ViewData["Title"] = "Register New Member";
}

<div class="container py-5" style="background-color: #0E0F11; color: #FFFFFF; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-6 p-4 rounded" style="background-color: #1E2124; border: 1px solid #2F3338;">
            <h2 class="text-center mb-4" style="color: #D4E84A;">Mawethu Gym Registration</h2>
            
            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EmergencyContact" class="form-label"></label>
                    <input asp-for="EmergencyContact" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="EmergencyContact" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PlanType" class="form-label">Membership Plan</label>
                    <select asp-for="PlanType" class="form-select bg-dark text-white border-secondary">
                        <option value="1 Month">1 Month - R260</option>
                        <option value="3 Months">3 Months - R480</option>
                        <option value="6 Months">6 Months - R900</option>
                    </select>
                </div>

                <!-- POPIA Compliance Consent Box -->
                <div class="mb-4 form-check p-3 rounded" style="background-color: #2F3338;">
                    <input asp-for="BiometricConsentGiven" class="form-check-input" type="checkbox" id="consentCheck" />
                    <label class="form-check-label text-light small" for="consentCheck">
                        I explicitly consent to Magnificent Mawethu Gym processing my biometric face data for check-in purposes, in accordance with POPIA. I understand I can withdraw this consent at any time[cite: 5].
                    </label>
                    <span asp-validation-for="BiometricConsentGiven" class="text-danger d-block mt-1"></span>
                </div>

                <button type="submit" class="btn w-100 fw-bold py-2" style="background-color: #D4E84A; color: #0E0F11;">Complete Registration</button>
            </form>
        </div>
    </div>
</div>
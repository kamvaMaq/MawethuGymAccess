@model MawethuGym.Web.Models.Member

@{
    ViewData["Title"] = "Member Dashboard";
}

<div class="container py-5" style="background-color: #0E0F11; color: #FFFFFF; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-6 p-4 rounded" style="background-color: #1E2124; border: 1px solid #2F3338;">
            <h2 class="mb-3" style="color: #D4E84A;">Welcome, @Model.FullName!</h2>
            <hr class="border-secondary" />
            <p><strong>Member Number:</strong> <span class="text-warning">@Model.MemberNumber</span></p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Plan Type:</strong> @Model.PlanType</p>
            <p><strong>Expiry Date:</strong> @Model.ExpiryDate.ToString("yyyy-MM-dd")</p>
            
            <div class="mt-4 p-3 rounded" style="background-color: #2F3338;">
                <h5 class="text-light">Access Status</h5>
                <span class="badge bg-success fs-6">Active Membership</span>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<MawethuGym.Web.Data.CheckIn>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5" style="background-color: #0E0F11; color: #FFFFFF; min-height: 100vh;">
    <h2 class="mb-4" style="color: #D4E84A;">Gym Management Dashboard</h2>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="p-4 rounded" style="background-color: #1E2124; border: 1px solid #2F3338;">
                <h5 class="text-muted">Total Registered Members</h5>
                <h3 class="fw-bold text-light">@ViewBag.TotalMembers</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-4 rounded" style="background-color: #1E2124; border: 1px solid #2F3338;">
                <h5 class="text-muted">Active Memberships</h5>
                <h3 class="fw-bold" style="color: #D4E84A;">@ViewBag.ActiveMembers</h3>
            </div>
        </div>
    </div>

    <div class="p-4 rounded" style="background-color: #1E2124; border: 1px solid #2F3338;">
        <h4 class="mb-3 text-light">Recent Access Logs</h4>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Member Name</th>
                        <th>Member Number</th>
                        <th>Check-in Time</th>
                        <th>Method</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.Member.FullName</td>
                            <td class="text-warning">@log.Member.MemberNumber</td>
                            <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@log.Method</td>
                            <td><span class="badge bg-success">Success</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>